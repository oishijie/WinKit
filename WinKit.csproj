<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinKit</AssemblyName>
    <RootNamespace>WinKit</RootNamespace>
    <Version>2.4.1</Version>
    <Authors>WinKit Developer</Authors>
    <Description>统一桌面助手 (TodoList &amp; Clipboard &amp; 本地 OCR 翻译)</Description>
    <ApplicationIcon>PTD.ico</ApplicationIcon>

    <!--
      ONNX Runtime 的原生库只提供 x64 版本，必须锁定 x64 进程。
      （原 Paddle 方案同样只支持 x64，此项保持不变）
    -->
    <PlatformTarget>x64</PlatformTarget>

    <!--
      ⚠ 体积关键项：锁定运行时标识符为 win-x64。
      未设置 RID 时，NuGet 会把 Microsoft.ML.OnnxRuntime 与 SkiaSharp 里
      **全部平台**的原生资产平铺到 runtimes\ 下 —— 含 Android 的 onnxruntime.aar、
      iOS 的 onnxruntime.xcframework.zip、二十余个 Linux 发行版的 libSkiaSharp.so 等，
      实测高达 378MB，而真正需要的只有 win-x64 的几十 MB。

      AppendRuntimeIdentifierToOutputPath=false：保持输出目录仍是
      bin\Release\net8.0-windows\（不追加 \win-x64\ 子目录），与原有发布流程一致。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>false</SelfContained>

    <!-- 优化发布选项 -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>

    <!--
      ⚠ 本地第三方参考源码副本（调研用，已在 .gitignore 排除）绝不参与编译。
      WPF SDK 默认把 **/*.cs 收成 Compile、**/*.xaml 收成 Page：官方 SyncClipboard
      客户端里带 WinUI3 的 App.xaml / Views/*.xaml，一旦被卷进来就会刷一屏 MC3074
      并直接打断构建。DefaultItemExcludes 对所有默认项（含 None / Content）一次性生效，
      不影响下方 Rack\Assets 的显式 Content Include。
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ScreenCapture-main\**;SnowAir-main\**;SyncClipboard-master\**;SyncClipboardCfServer-master\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 本地 OCR 依赖版本，集中维护 -->
    <RapidOcrNetVersion>4.2.0</RapidOcrNetVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms 会自动注入两条全局 using，二者都会与 WPF 冲突：
        · System.Windows.Forms → Application / MouseEventArgs / KeyEventArgs / TextBox 等
        · System.Drawing        → Color / Brush / Rectangle / Point / Image 等
      本项目所有 WinForms 与 GDI+ 用法均已显式限定或显式 using
      （SWF.NotifyIcon / System.Drawing.Bitmap / using System.Drawing; / 别名），
      因此统一移除这两条隐式全局引用，避免类型二义性。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!--
      本地 OCR：ONNX Runtime 推理（RapidOcrNet 托管封装 + Microsoft.ML.OnnxRuntime 原生运行时）。
      相比旧的 Paddle 方案（paddle_inference + mklml + opencv_world + mkldnn ≈ 386MB），
      原生负载降到约 13MB，配合 PP-OCRv6 的 ONNX 模型（约 37MB）即可完整离线识别。

      ExcludeAssets="build"：屏蔽包自带的 build targets —— 它会把 v5 拉丁文模型（约 14MB）
      复制到输出目录，而本项目统一使用 v6 多语言模型（见下方 models\ 规则），不需要这份冗余副本。
    -->
    <PackageReference Include="RapidOcrNet" Version="$(RapidOcrNetVersion)" ExcludeAssets="build" />
  </ItemGroup>

  <!-- ══ 本地 OCR 模型布局 ═══════════════════════════════════════════════
       输出目录结构：
         WinKit.exe
         models\    PP-OCRv6 ONNX 模型与字典（det / rec / cls / dict）
       运行期由 RapidOcrProvider 从 models\ 解析模型路径。
  -->
  <ItemGroup>
    <None Update="models\**\*.*" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    晾衣架主题素材（Rack/Assets，约 1.83MB）：信封 / 篮子 / 4 套主题预览图 /
    letter.png 信纸卡 / iconfont.ttf 图标字体。
    以 Content 形式随输出目录分发，而不是嵌进程序集 ——
    这样主题切换可按文件名直接换图，且第三方素材的 NOTICE.txt 能原样随包保留。
    许可见 Rack/Assets/NOTICE.txt（Apache-2.0 素材 + PicRope MIT 衍生图）。
  -->
  <ItemGroup>
    <None Remove="Rack\Assets\**\*.png" />
    <None Remove="Rack\Assets\**\*.ttf" />
    <Resource Remove="Rack\Assets\**\*.png" />
    <Resource Remove="Rack\Assets\**\*.ttf" />
    <Content Include="Rack\Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Rack\Assets\**\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Rack\Assets\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 缺少模型会导致应用启动后 OCR 完全不可用，这里在构建期直接拦截 -->
  <Target Name="VerifyLocalOcrModels" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(OutDir)models\PP-OCRv6_det_small.onnx')"
           Text="本地 OCR 模型缺失：未能生成 $(OutDir)models\PP-OCRv6_det_small.onnx。请确认项目 models\ 目录下存在 PP-OCRv6 的 ONNX 模型。" />
    <Error Condition="!Exists('$(OutDir)models\PP-OCRv6_rec_small.onnx')"
           Text="本地 OCR 模型缺失：未能生成 $(OutDir)models\PP-OCRv6_rec_small.onnx。" />
    <Error Condition="!Exists('$(OutDir)models\PP-OCRv6_small_dict.txt')"
           Text="本地 OCR 识别字典缺失：未能生成 $(OutDir)models\PP-OCRv6_small_dict.txt。" />
  </Target>

  <ItemGroup>
    <!-- 将 PTD.ico 作为嵌入资源，以便托盘读取，同时编译为应用程序图标 -->
    <Resource Include="PTD.ico" />
    <EmbeddedResource Include="PTD.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 排除外部参考项目，防止其代码和 XAML 被默认编译进去 -->
    <Compile Remove="MiniPaste\**\*" />
    <Compile Remove="PinToD\**\*" />
    <Page Remove="MiniPaste\**\*" />
    <Page Remove="PinToD\**\*" />
  </ItemGroup>

</Project>
