<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      只保留国内镜像。
      本机直连 api.nuget.org 必须走代理，且代理在拉包时频繁 TLS 握手超时
      （实测 "net/http: TLS handshake timeout"），因此这里清掉继承的全局源，
      统一走腾讯云镜像（v2 协议，国内直连稳定）。
    -->
    <clear />
    <add key="tencent" value="https://mirrors.tencent.com/nuget/" />
  </packageSources>
</configuration>
