<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      只保留国内镜像。
      本机直连 api.nuget.org 必须走代理，且代理在拉包时频繁 TLS 握手超时
      （实测 "net/http: TLS handshake timeout"），因此这里清掉继承的全局源，
      统一走腾讯云镜像（v2 协议，国内直连稳定）。
    -->
    <clear />
    <add key="tencent" value="https://mirrors.tencent.com/nuget/" />
    <!--
      备用源：腾讯镜像（Nexus）缺部分精确版本 —— 实测 SDK 10 还原 net8.0 要求
      Microsoft.AspNetCore.App.Ref 精确 = 8.0.29，腾讯只有 8.0.33，报 NU1102。
      华为云是 nuget.org 全量代理且国内直连稳定，兜底补缺；NuGet 按源顺序优先腾讯。
    -->
    <add key="huawei" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>
