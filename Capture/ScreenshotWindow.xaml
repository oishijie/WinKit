<Window x:Class="WinKit.Capture.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_KeyDown">

    <!--
        选区层视觉对齐 SnowAir 截图栏：
          选区边框  #34C759 / 1px
          夹点      8 个 8x8 白色方块 + 1px 绿边（四角 + 四边中点）
          信息条    高 36 / #1E1E1E 75% / 白字，显示 X / Y 坐标与 W×H（物理像素）
        纯视觉层，不参与命中测试，框选与 Complete 流程保持原样。
    -->

    <Window.Resources>
        <Style x:Key="SelectionHandle" TargetType="Border">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#34C759"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <Canvas x:Name="RootCanvas">
        <!-- 截屏底图（覆盖整个虚拟屏幕） -->
        <Image x:Name="BgImage" Stretch="Fill"/>

        <!-- 半透明遮罩：通过 EvenOdd 规则在选区处镂空 -->
        <Path x:Name="DimMask" Fill="#99000000"/>

        <!-- 选区边框 -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#34C759"
                BorderThickness="1"
                Background="Transparent"
                Visibility="Collapsed"/>

        <!-- 8 个夹点。Canvas 不参与命中测试，避免抢走框选的鼠标事件 -->
        <Canvas x:Name="HandleLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="H0" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H1" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H2" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H3" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H4" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H5" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H6" Style="{StaticResource SelectionHandle}"/>
            <Border x:Name="H7" Style="{StaticResource SelectionHandle}"/>
        </Canvas>

        <!-- 选区坐标 / 尺寸信息条 -->
        <Border x:Name="SizeTip"
                Background="#BF1E1E1E"
                CornerRadius="4"
                Height="26"
                Padding="9,0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12"
                       VerticalAlignment="Center"
                       FontFamily="Consolas, Microsoft YaHei UI"/>
        </Border>

        <!-- 顶部操作提示：与信息条同一套深灰胶囊语言 -->
        <Border x:Name="HintBar"
                Background="#BF1E1E1E"
                CornerRadius="10"
                Padding="14,6"
                Canvas.Left="0"
                Canvas.Top="0"
                IsHitTestVisible="False">
            <TextBlock FontSize="12">
                <Run Text="拖拽选择截图区域" Foreground="White"/>
                <Run Text="   " />
                <Run Text="ESC 取消" Foreground="#99FFFFFF"/>
            </TextBlock>
        </Border>
    </Canvas>
</Window>
