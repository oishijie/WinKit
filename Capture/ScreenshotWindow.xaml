<Window x:Class="WinKit.Capture.ScreenshotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_KeyDown">

    <Canvas x:Name="RootCanvas">
        <!-- 截屏底图（覆盖整个虚拟屏幕） -->
        <Image x:Name="BgImage" Stretch="Fill"/>

        <!-- 半透明遮罩：通过 EvenOdd 规则在选区处镂空 -->
        <Path x:Name="DimMask" Fill="#99000000"/>

        <!-- 选区边框 -->
        <Border x:Name="SelectionBorder"
                BorderBrush="#1A8CFF"
                BorderThickness="1.5"
                Background="Transparent"
                Visibility="Collapsed"/>

        <!-- 选区尺寸提示 -->
        <Border x:Name="SizeTip"
                Background="#1A8CFF"
                CornerRadius="3"
                Padding="6,2"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="11"/>
        </Border>

        <!-- 顶部操作提示。只对齐圆角与文字层级，遮罩和选框的视觉保持原样 ——
             截图层是功能性的，改结构反而影响辨认。 -->
        <Border x:Name="HintBar"
                Background="#CC000000"
                CornerRadius="{StaticResource Radius8}"
                Padding="14,6"
                Canvas.Left="0"
                Canvas.Top="0"
                IsHitTestVisible="False">
            <TextBlock FontSize="12">
                <Run Text="拖拽选择识别区域" Foreground="White"/>
                <Run Text="   " />
                <Run Text="ESC 取消" Foreground="#99FFFFFF"/>
            </TextBlock>
        </Border>
    </Canvas>
</Window>
