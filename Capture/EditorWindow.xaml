<Window x:Class="WinKit.Capture.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit 截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">

    <!--
        图片标注编辑器。工具条按 SnowAir 截图栏复刻：
          · 居中黑色胶囊条（#1E1E1E / 圆角 10 / 24px 拖拽把手）
          · 17 个 24x24 图标键，槽位顺序与参考一致
          · 「更多」展开浮动子工具条：颜色 / 线宽 / 椭圆 / 重做 / 挂衣架
        仍然采用三段式窗口（图像 / 工具条 / 状态），保证大图滚动、
        DPI 钳制、拖动与 ComposeImage 合成路径不变。
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Capture/CaptureIcons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ══ 胶囊图标按钮：绘图工具（互斥选中） ══
                 Tag 存 StreamGeometry，CommandParameter 存工具名字符串。 -->
            <Style x:Key="CapToolBtn" TargetType="RadioButton">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Foreground" Value="#E8E8E8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                <Path x:Name="ic"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                                    <Setter TargetName="ic" Property="Fill" Value="#FFFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2634C759"/>
                                    <Setter TargetName="ic" Property="Fill" Value="#34C759"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ic" Property="Opacity" Value="0.28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ 胶囊图标按钮：一次性动作 ══ -->
            <Style x:Key="CapActionBtn" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Foreground" Value="#E8E8E8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                <Path x:Name="ic"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="19" Height="19" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                                    <Setter TargetName="ic" Property="Fill" Value="#FFFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#38FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ic" Property="Opacity" Value="0.28"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CapSep" TargetType="Border">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Background" Value="#33FFFFFF"/>
                <Setter Property="Margin" Value="6,0"/>
            </Style>

            <Style x:Key="SubLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8A8A8A"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="2,0,8,0"/>
            </Style>

            <!-- 子工具条里的文字型互斥按钮（线宽） -->
            <Style x:Key="SubTextBtn" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#CCCCCC"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                    Padding="10,4" Margin="1,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#2634C759"/>
                                    <Setter Property="Foreground" Value="#34C759"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 文字样式条里的小号文字按钮：字号 -/+ 与确定/取消 -->
            <Style x:Key="MiniBtn" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Foreground" Value="#E8E8E8"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#24FFFFFF"/>
                                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 颜色选择：圆形色块，选中时外围加白圈 -->
            <Style x:Key="ColorBtn" TargetType="RadioButton">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"
                                         Width="18" Height="18"/>
                                <Ellipse x:Name="dot" Width="12" Height="12"
                                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ring" Property="Stroke" Value="#FFFFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 窗口整体透明：只保留图片 + 黑色胶囊工具条 + 一行状态小字。
         旧版这里是不透明 #FF202020 底板 + 10px 外边距 + 投影 + 白边，
         会在工具条四周糊出一整圈「大黑边」，已全部去掉。 -->
    <Border x:Name="RootBorder" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ 图像 + 标注层 ══ -->
            <ScrollViewer x:Name="ImageScroller"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="Transparent"
                          Focusable="False">
                <!-- 小截图时窗口会被胶囊条撑宽，这里若填深色就会露出一大片黑底；
                     改透明后图片之外直接透出桌面，BaseImage 铺满 ImageHost，
                     ComposeImage 的渲染结果不受影响。 -->
                <Grid x:Name="ImageHost" Background="Transparent">
                    <Image x:Name="BaseImage" Stretch="Fill"/>
                    <Canvas x:Name="OverlayCanvas"
                            Background="Transparent"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseMove="Canvas_MouseMove"
                            MouseRightButtonDown="Canvas_MouseRightButtonDown"
                            MouseLeftButtonUp="Canvas_MouseLeftButtonUp">

                        <!-- ══ 文字标注就地编辑的浮动样式条 ══
                             只在编辑期间存在，提交/取消时立即移除，
                             因此不会被 ComposeImage 截进导出图片。 -->
                        <Border x:Name="TextStyleBar"
                                Visibility="Collapsed"
                                Panel.ZIndex="20"
                                Background="#F21E1E1E"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TextColorRed" GroupName="TextColor"
                                             Style="{StaticResource ColorBtn}" Tag="#FF3B30"
                                             Focusable="False" IsChecked="True"
                                             Checked="TextColor_Checked" ToolTip="红色"/>
                                <RadioButton x:Name="TextColorYellow" GroupName="TextColor"
                                             Style="{StaticResource ColorBtn}" Tag="#FFD60A"
                                             Focusable="False" Checked="TextColor_Checked" ToolTip="黄色"/>
                                <RadioButton x:Name="TextColorGreen" GroupName="TextColor"
                                             Style="{StaticResource ColorBtn}" Tag="#34C759"
                                             Focusable="False" Checked="TextColor_Checked" ToolTip="绿色"/>
                                <RadioButton x:Name="TextColorBlue" GroupName="TextColor"
                                             Style="{StaticResource ColorBtn}" Tag="#0A84FF"
                                             Focusable="False" Checked="TextColor_Checked" ToolTip="蓝色"/>
                                <RadioButton x:Name="TextColorWhite" GroupName="TextColor"
                                             Style="{StaticResource ColorBtn}" Tag="#FFFFFF"
                                             Focusable="False" Checked="TextColor_Checked" ToolTip="白色"/>

                                <Border Style="{StaticResource CapSep}"/>

                                <Button x:Name="BtnTextSizeDown" Style="{StaticResource MiniBtn}"
                                        Content="-" Click="TextSizeDown_Click" ToolTip="缩小字号"/>
                                <TextBlock x:Name="TextSizeLabel" Text="20"
                                           Foreground="#CCCCCC" FontSize="12"
                                           Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button x:Name="BtnTextSizeUp" Style="{StaticResource MiniBtn}"
                                        Content="+" Click="TextSizeUp_Click" ToolTip="放大字号"/>

                                <Border Style="{StaticResource CapSep}"/>

                                <Button x:Name="BtnTextOk" Style="{StaticResource CapActionBtn}"
                                        Tag="{StaticResource CapIconCheck}" Foreground="#34C759"
                                        Click="TextOk_Click" ToolTip="确定 (Enter)"/>
                                <Button x:Name="BtnTextCancel" Style="{StaticResource CapActionBtn}"
                                        Tag="{StaticResource CapIconClose}"
                                        Click="TextCancel_Click" ToolTip="取消 (Esc)"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- ══ 浮动子工具条：由「更多」切换，浮在图像上不占布局高度 ══ -->
            <Border x:Name="SubToolBar"
                    Grid.Row="0"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Background="#F21E1E1E"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,8"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton x:Name="ToolEllipse" GroupName="Tool"
                                     Style="{StaticResource CapToolBtn}"
                                     Tag="{StaticResource CapIconEllipse}"
                                     CommandParameter="Ellipse"
                                     Checked="Tool_Checked" ToolTip="椭圆"/>
                        <RadioButton x:Name="ToolLine" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                     Tag="{StaticResource CapIconLine}" CommandParameter="Line"
                                     Checked="Tool_Checked" ToolTip="直线"/>
                        <Button x:Name="BtnRedo" Style="{StaticResource CapActionBtn}"
                                Tag="{StaticResource CapIconRedo}"
                                IsEnabled="False"
                                Click="RedoBtn_Click" ToolTip="重做 (Ctrl+Y)"/>
                        <RadioButton x:Name="ToolHighlight" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                     Tag="{StaticResource CapIconHighlight}" CommandParameter="Highlight"
                                     Checked="Tool_Checked" ToolTip="聚焦高亮：拖框，框外压暗 55%"/>
                        <Border Style="{StaticResource CapSep}"/>
                        <TextBlock Text="颜色" Style="{StaticResource SubLabel}"/>
                        <RadioButton x:Name="ColorRed" GroupName="Color" Style="{StaticResource ColorBtn}"
                                     Tag="#FF3B30" IsChecked="True" Checked="Color_Checked"/>
                        <RadioButton x:Name="ColorYellow" GroupName="Color" Style="{StaticResource ColorBtn}"
                                     Tag="#FFD60A" Checked="Color_Checked"/>
                        <RadioButton x:Name="ColorGreen" GroupName="Color" Style="{StaticResource ColorBtn}"
                                     Tag="#34C759" Checked="Color_Checked"/>
                        <RadioButton x:Name="ColorBlue" GroupName="Color" Style="{StaticResource ColorBtn}"
                                     Tag="#0A84FF" Checked="Color_Checked"/>
                        <RadioButton x:Name="ColorWhite" GroupName="Color" Style="{StaticResource ColorBtn}"
                                     Tag="#FFFFFF" Checked="Color_Checked"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="线宽" Style="{StaticResource SubLabel}"/>
                        <RadioButton x:Name="ThinWidth" GroupName="Width" Style="{StaticResource SubTextBtn}"
                                     Content="细" CommandParameter="1.5" Checked="Width_Checked"/>
                        <RadioButton x:Name="MidWidth" GroupName="Width" Style="{StaticResource SubTextBtn}"
                                     Content="中" CommandParameter="2.5" IsChecked="True" Checked="Width_Checked"/>
                        <RadioButton x:Name="ThickWidth" GroupName="Width" Style="{StaticResource SubTextBtn}"
                                     Content="粗" CommandParameter="4" Checked="Width_Checked"/>
                        <TextBlock Text="工具" Style="{StaticResource SubLabel}" Margin="14,0,8,0"/>
                        <TextBlock x:Name="CurrentToolText" Text="矩形" Foreground="#34C759"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ 主工具条：居中黑色胶囊，17 键 ══ -->
            <Border x:Name="CapBar"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,2"
                    Background="#F21E1E1E"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,5"
                    MouseLeftButtonDown="CapBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 拖拽把手 -->
                    <Border Width="24" Height="36" Background="Transparent" Cursor="SizeAll">
                        <Path Data="{StaticResource CapIconGrip}" Fill="#66FFFFFF"
                              Width="14" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False"/>
                    </Border>

                    <!-- 1 显示鼠标指针（占位） -->
                    <Button x:Name="BtnCursor" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconCursor}"
                            IsEnabled="False" ToolTip="显示鼠标指针（后续版本）"/>
                    <!-- 2 矩形 -->
                    <RadioButton x:Name="ToolRect" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconRect}" CommandParameter="Rect"
                                 IsChecked="True" Checked="Tool_Checked" ToolTip="矩形"/>
                    <!-- 3 箭头 -->
                    <RadioButton x:Name="ToolArrow" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconArrow}" CommandParameter="Arrow"
                                 Checked="Tool_Checked" ToolTip="箭头"/>
                    <!-- 4 画笔 -->
                    <RadioButton x:Name="ToolPen" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconPen}" CommandParameter="Pen"
                                 Checked="Tool_Checked" ToolTip="画笔"/>
                    <!-- 5 文字：拖框 → 就地输入 → 确定 -->
                    <RadioButton x:Name="ToolText" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconText}" CommandParameter="Text"
                                 Checked="Tool_Checked" ToolTip="文字标注：拖出文本框后输入"/>
                    <!-- 6 序号：点一下放一个自增圆徽标，可连续点 -->
                    <RadioButton x:Name="ToolNumber" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconNumber}" CommandParameter="Number"
                                 Checked="Tool_Checked" ToolTip="序号标注：点一下放一个，自动编号"/>
                    <!-- 7 马赛克 -->
                    <RadioButton x:Name="ToolMosaic" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconMosaic}" CommandParameter="Mosaic"
                                 Checked="Tool_Checked" ToolTip="马赛克"/>
                    <!-- 8 橡皮擦 -->
                    <RadioButton x:Name="ToolEraser" GroupName="Tool" Style="{StaticResource CapToolBtn}"
                                 Tag="{StaticResource CapIconEraser}" CommandParameter="Eraser"
                                 Checked="Tool_Checked" ToolTip="橡皮擦"/>

                    <Border Style="{StaticResource CapSep}"/>

                    <!-- 9 撤销 -->
                    <Button x:Name="BtnUndo" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconUndo}"
                            IsEnabled="False" Click="UndoBtn_Click" ToolTip="撤销 (Ctrl+Z)"/>
                    <!-- 10 更多 -->
                    <Button x:Name="BtnMore" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconMore}"
                            Click="BtnMore_Click" ToolTip="更多：颜色 / 线宽 / 椭圆 / 重做"/>

                    <Border Style="{StaticResource CapSep}"/>

                    <!-- 11 钉图 -->
                    <Button x:Name="BtnPin" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconPin}"
                            Click="PinBtn_Click" ToolTip="钉到桌面"/>
                    <!-- 12 OCR：对「底图 + 已有标注」合成图做离线识别，结果弹现有 ResultWindow -->
                    <Button x:Name="BtnOcr" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconOcr}"
                            Click="OcrBtn_Click" ToolTip="OCR 识别当前编辑结果"/>
                    <!-- 13 翻译：先 OCR 再走 ITranslator，同样弹 ResultWindow -->
                    <Button x:Name="BtnTranslate" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconTranslate}"
                            Click="TranslateBtn_Click" ToolTip="翻译当前编辑结果（先 OCR）"/>
                    <!-- 14 长截图（占位） -->
                    <Button x:Name="BtnLong" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconLong}"
                            IsEnabled="False" ToolTip="长截图（后续版本）"/>
                    <!-- 15 另存为 -->
                    <Button x:Name="BtnSave" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconSave}"
                            Click="SaveBtn_Click" ToolTip="另存为 PNG"/>
                    <!-- 16 取消 -->
                    <Button x:Name="BtnClose" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconClose}"
                            Click="CloseBtn_Click" ToolTip="取消 (Esc)"/>
                    <!-- 17 完成 -->
                    <Button x:Name="BtnConfirm" Style="{StaticResource CapActionBtn}"
                            Tag="{StaticResource CapIconCheck}"
                            Foreground="#34C759"
                            Click="CopyBtn_Click" ToolTip="完成：复制到剪贴板"/>
                </StackPanel>
            </Border>

            <!-- ══ 底部状态：只留一行紧贴文字的小标签，不再铺满整行的深色状态条 ══ -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    HorizontalAlignment="Left"
                    Margin="4,2,0,2">
                <TextBlock x:Name="StatusText"
                           Text="已复制到剪贴板"
                           Foreground="#C0C0C0"
                           Background="#991E1E1E"
                           Padding="6,2"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</Window>
