<Window x:Class="WinKit.Capture.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit 截图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <!-- 工具按钮（互斥选中） -->
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="10,5" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0A6CFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 动作按钮 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="10,5" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏竖分隔线 -->
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Margin" Value="7,0"/>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#FF202020"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="8">
        <DockPanel>

            <!-- ══ 工具栏（兼作拖动条） ══ -->
            <Border x:Name="ToolBar"
                    DockPanel.Dock="Top"
                    Background="#FF2B2B2B"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="ToolBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="8,7">

                    <RadioButton x:Name="ToolRect"   Content="矩形"   GroupName="Tool"
                                 Style="{StaticResource ToolBtn}" IsChecked="True"
                                 Checked="Tool_Checked" Tag="Rect"/>
                    <RadioButton x:Name="ToolArrow"  Content="箭头"   GroupName="Tool"
                                 Style="{StaticResource ToolBtn}"
                                 Checked="Tool_Checked" Tag="Arrow"/>
                    <RadioButton x:Name="ToolPen"    Content="画笔"   GroupName="Tool"
                                 Style="{StaticResource ToolBtn}"
                                 Checked="Tool_Checked" Tag="Pen"/>
                    <RadioButton x:Name="ToolMosaic" Content="马赛克" GroupName="Tool"
                                 Style="{StaticResource ToolBtn}"
                                 Checked="Tool_Checked" Tag="Mosaic"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <Button x:Name="UndoBtn" Content="撤销" Style="{StaticResource ActionBtn}"
                            IsEnabled="False" Click="UndoBtn_Click"/>
                    <Button x:Name="RedoBtn" Content="重做" Style="{StaticResource ActionBtn}"
                            IsEnabled="False" Click="RedoBtn_Click"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <Button Content="复制" Style="{StaticResource ActionBtn}" Click="CopyBtn_Click"/>
                    <Button Content="另存为" Style="{StaticResource ActionBtn}" Click="SaveBtn_Click"/>
                    <Button Content="关闭" Style="{StaticResource ActionBtn}" Click="CloseBtn_Click"/>

                    <TextBlock x:Name="StatusText" Text="已复制到剪贴板"
                               Foreground="#88FFFFFF" FontSize="11.5"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                </StackPanel>
            </Border>

            <!-- ══ 图像 + 标注层 ══ -->
            <Grid x:Name="ImageHost" Background="#FF101010">
                <Image x:Name="BaseImage" Stretch="Fill"/>
                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
            </Grid>

        </DockPanel>
    </Border>
</Window>
