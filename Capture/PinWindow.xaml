<Window x:Class="WinKit.Capture.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="贴图"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">

    <!--
        贴图窗口：把截图钉在桌面当参考图。
        基础版能力：置顶无边框、拖动移动、滚轮缩放、双击/Esc 关闭。
        不含标注（标注仍在 EditorWindow 里做，钉图用的是合成后的最终图）。
    -->

    <Border x:Name="RootBorder"
            Margin="10"
            Background="#FF202020"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius12}"
            Effect="{StaticResource WinShadow}"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseWheel="Root_MouseWheel">
        <Grid>
            <Image x:Name="PinImage" Stretch="Fill"/>

            <!-- 右上角关闭按钮：悬停显示，避免干扰贴图观感 -->
            <Button x:Name="CloseBtn"
                    Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,6,6,0"
                    Padding="8,3"
                    Style="{StaticResource WinBtnDark}"
                    Opacity="0"
                    Click="CloseBtn_Click"
                    ToolTip="关闭贴图"/>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseBtn"
                                     Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CloseBtn"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0" Duration="0:0:0.15"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
