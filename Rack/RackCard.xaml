<UserControl x:Class="WinKit.Rack.RackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonDown="Card_MouseLeftButtonDown"
             MouseMove="Card_MouseMove">

    <!--
        晾衣架卡片：三种形态（图片 / 文本 / 待办），点击复制、拖出分享。
        外观：圆角卡片 + 投影，深色底适配置顶悬浮。
    -->

    <Border x:Name="CardBorder"
            Background="#FF2B2B2B"
            BorderBrush="#4DFFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6"
            MaxWidth="160"
            Effect="{StaticResource WinShadow}">
        <StackPanel>
            <!-- 图片卡 -->
            <Image x:Name="ImgPreview"
                   Stretch="Uniform"
                   MaxHeight="90"
                   MaxWidth="140"
                   Visibility="Collapsed"/>

            <!-- 文本/待办卡 -->
            <StackPanel x:Name="TextArea" Visibility="Collapsed">
                <!-- 类型色头 -->
                <Border x:Name="TypeBar" Height="3" CornerRadius="2" Margin="0,0,0,5"/>
                <TextBlock x:Name="TextContent"
                           Foreground="#E0E0E0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxWidth="140"
                           TextTrimming="CharacterEllipsis"/>
                <!-- 待办勾选标记 -->
                <TextBlock x:Name="DoneMark"
                           Text="✓"
                           Foreground="#34C759"
                           FontSize="11"
                           Visibility="Collapsed"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
