<UserControl x:Class="WinKit.Rack.RackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             ClipToBounds="False">

    <!--
        晾衣架卡片 —— 一比一复刻 SnowAir-Rack 的模板：
          · 照片卡：白边 + 圆角 + 投影 + 顶部夹子
          · 文本 / 便签 / 待办卡：插件自带 letter.png 信纸作底（浅色主题）
          · 其余类型方卡：20% 外圈 + 白底 + 4px 类型色头
        尺寸由 RackWindow 在布局时写 UserControl.Width / Height，这里只负责渲染。
    -->

    <Grid x:Name="RootGrid" ClipToBounds="False">

        <!-- 顶部夹子（照片卡与方卡共用） -->
        <Border x:Name="ClipBody"
                Width="14" Height="20"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,-13,0,0"
                Background="#C9A227"
                BorderBrush="#66000000" BorderThickness="1"
                CornerRadius="3"
                IsHitTestVisible="False"
                Panel.ZIndex="3">
            <Ellipse Width="6" Height="6" Fill="#66FFFFFF"
                     VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </Border>

        <!-- ══ 照片卡 ══ -->
        <Border x:Name="PhotoOuter"
                Background="#FFFFFF"
                BorderBrush="#33000000" BorderThickness="1"
                CornerRadius="3"
                Padding="6,6,6,16"
                Effect="{StaticResource WinShadow}"
                Panel.ZIndex="1">
            <Border x:Name="PhotoInner" Background="#1A000000" CornerRadius="1">
                <Image x:Name="ImgPreview" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
            </Border>
        </Border>

        <!-- ══ 类型方卡：20% 外圈 + 白底 / letter.png 信纸 ══ -->
        <Grid x:Name="SquareCard" Panel.ZIndex="1">
            <Border x:Name="OuterRing"
                    Margin="-4"
                    Background="Transparent"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="4"
                    CornerRadius="10"
                    IsHitTestVisible="False"/>
            <Border x:Name="SquareBody"
                    Background="#FFFFFF"
                    BorderBrush="#33000000" BorderThickness="1"
                    CornerRadius="7"
                    ClipToBounds="True"
                    Effect="{StaticResource WinShadow}">
                <Grid>
                    <Image x:Name="LetterBg" Stretch="Fill" Visibility="Collapsed"
                           IsHitTestVisible="False" Panel.ZIndex="0"/>
                    <Grid Panel.ZIndex="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 4px 类型色头 -->
                        <Border x:Name="TypeBar" Grid.Row="0" Height="4"
                                CornerRadius="6,6,0,0" Background="#AC7F5E"/>

                        <StackPanel x:Name="ContentStack" Grid.Row="1" Margin="9,7,9,4">
                            <TextBlock x:Name="TypeLabel"
                                       Text="文本" FontSize="10" Foreground="#999"
                                       Margin="0,0,0,3"/>
                            <TextBlock x:Name="TextContent"
                                       Foreground="#222" FontSize="12"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       MaxHeight="72"/>
                            <Border x:Name="ColorSwatch" Height="26" CornerRadius="4"
                                    Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <TextBlock x:Name="DoneMark" Grid.Row="2"
                                   Text="已完成" FontSize="10" Foreground="#34C759"
                                   Margin="9,0,9,7" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 锁定标记 -->
        <Border x:Name="LockBadge"
                Width="18" Height="18" CornerRadius="9"
                Background="#E6000000"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-7,-7,0"
                Panel.ZIndex="4"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock Text="锁" FontSize="10" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 右键菜单 -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="复制到剪贴板" Click="MenuCopy_Click"/>
                <MenuItem x:Name="MenuLock" Header="锁定卡片" Click="MenuLock_Click"/>
                <Separator/>
                <MenuItem Header="从晾衣架移除" Click="MenuRemove_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</UserControl>
