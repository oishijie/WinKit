<UserControl x:Class="WinKit.Rack.RackListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" Height="550"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             Margin="126,88,0,0"
             Panel.ZIndex="6"
             Visibility="Collapsed">

    <!--
        信封 / 篮子的合并气泡 —— 按 SnowAir-Rack ClipboardBubble.cpp 的几何规格复刻：
        宽 380、高 550、圆角 16、顶部 9px 箭头指向入口、内边距 12、
        搜索框 32、分类 chip 28、卡片圆角 8、20x20 图标按钮。
        图标来自插件自带的 assets/iconfont.ttf（字形轮廓，不是贴图）。
        浅色 #FFFFFF 面板 / #F5F4F4 卡片，深色 #262626 / #1A1A1A。
        两个入口共用一个控件：信封＝剪贴板合并池，篮子＝待办合并池。
        文本与待办只在池里合并显示，绝不自动挂到绳子上。
    -->

    <UserControl.Resources>
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Background" Value="#FFF5F4F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FF3A3A3A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 顶部小箭头：顶点指向信封 / 篮子，位置由 SetAnchor 决定 -->
        <Path x:Name="Arrow"
              Fill="#FFFFFFFF" Stroke="#33000000" StrokeThickness="1"
              Panel.ZIndex="7" IsHitTestVisible="False"/>

        <Border x:Name="Bubble"
                Margin="0,9,0,0"
                Background="#FFFFFFFF"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,10,12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="TitleText" Text="剪贴板"
                               FontSize="13" Foreground="#FF2B2B2B"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseBtn" HorizontalAlignment="Right"
                            Width="20" Height="20" FontSize="12"
                            Content="×" ToolTip="关闭"
                            Style="{StaticResource FlatIconButton}"
                            Click="CloseBtn_Click"/>
                </Grid>

                <Grid Grid.Row="1" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Background="#FFF5F4F4" BorderThickness="0"
                             Padding="10,0" VerticalContentAlignment="Center"
                             FontSize="12" Foreground="#FF2B2B2B"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button x:Name="NewBtn" Grid.Column="1"
                            Width="32" Height="32" Margin="8,0,0,0"
                            FontSize="15" Content="+" ToolTip="新建便签并挂上绳子"
                            Style="{StaticResource FlatIconButton}"
                            Click="NewBtn_Click"/>
                    <Button x:Name="ChipBtn" Grid.Column="2"
                            Width="32" Height="32" Margin="8,0,0,0"
                            FontSize="12" Content="类" ToolTip="显示 / 隐藏分类筛选"
                            Style="{StaticResource FlatIconButton}"
                            Click="ChipBtn_Click"/>
                </Grid>

                <WrapPanel x:Name="ChipBar" Grid.Row="2" Margin="0,10,0,0"/>

                <ScrollViewer Grid.Row="3"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <StackPanel x:Name="EntryList"/>
                </ScrollViewer>

                <TextBlock x:Name="HintText" Grid.Row="4"
                           Margin="0,8,0,0"
                           FontSize="11" Foreground="#FF8A8A8A"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
