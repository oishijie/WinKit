<!-- Background 恒为 null：透明区域点击穿透到下层窗口。顶部热区靠 Win32 坐标轮询判定，不依赖 WPF 命中测试 -->
<Window x:Class="WinKit.Rack.RackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinKit.Rack"
        Title="晾衣架"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="False">

    <!--
        晾衣架 —— 一比一复刻 SnowAir-Rack：
          近水平微垂横杆 + 金属夹子 + 左信封（back/front 分层）+ 右篮子；
          主体装饰全部用插件自带 assets PNG，按原图比例摆放（信封 340x376、篮子 224x224）；
          左信封＝剪贴板合并气泡，右篮子＝待办合并气泡，两边都只是「池」，
          文本 / 待办不会自动上绳，绳上默认只有截图和用户主动挂上的卡片。
        收起态只留顶部 8px 热区；自动收起靠 50ms 轮询鼠标位置 + 时间戳阈值。
    -->

    <Grid x:Name="Root">

        <!-- 装饰层：横杆 / 信封 / 篮子 -->
        <Canvas x:Name="DecorCanvas" Panel.ZIndex="0">
            <Path x:Name="RopePath"
                  IsHitTestVisible="False"
                  Stroke="#9A7B55"
                  StrokeThickness="2.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- 左端信封：back + front 叠放，顶上一个金属夹子挂到绳子上 -->
            <Grid x:Name="EnvelopeHost" Width="112" Height="124"
                  Cursor="Hand" ToolTip="信封：打开合并的剪贴板内容（不会自动挂到绳子上）"
                  MouseLeftButtonUp="Envelope_Click">
                <Image x:Name="EnvelopeBack" Stretch="Uniform" IsHitTestVisible="False"/>
                <Image x:Name="EnvelopeFront" Stretch="Uniform" IsHitTestVisible="False"/>
                <Border Width="9" Height="22" CornerRadius="4"
                        Background="#FFDDE3E9" BorderBrush="#FFA8B4BF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,-6,0,0" Panel.ZIndex="4" IsHitTestVisible="False">
                    <Border Width="1" Height="14" Background="#FFB7C2CC"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="EnvelopeBadge" Width="20" Height="20" CornerRadius="10"
                        Background="#FF34C759"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,24" Panel.ZIndex="5"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="EnvelopeBadgeText" Text="0" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 右端篮子：待办合并池，右下角是待办条数角标 -->
            <Grid x:Name="BasketHost" Width="112" Height="112">
                <Image x:Name="BasketImage" Stretch="Uniform" Cursor="Hand"
                       ToolTip="篮子：打开合并的待办（不会自动挂到绳子上）"
                       MouseLeftButtonUp="Basket_Click"/>
                <Border Width="9" Height="22" CornerRadius="4"
                        Background="#FFDDE3E9" BorderBrush="#FFA8B4BF" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,-6,0,0" Panel.ZIndex="4" IsHitTestVisible="False">
                    <Border Width="1" Height="14" Background="#FFB7C2CC"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="BasketBadge" Width="20" Height="20" CornerRadius="10"
                        Background="#FFFF9F0A"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,20" Panel.ZIndex="5"
                        IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock x:Name="BasketBadgeText" Text="0" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Canvas>

        <!-- 卡片层（金属夹子也挂在这里，保证压在卡片上沿） -->
        <Canvas x:Name="CardCanvas" Panel.ZIndex="2"/>

        <!-- 合并气泡：同一控件两种数据源，点信封或篮子切换 -->
        <local:RackListPanel x:Name="ListPanel"/>

        <!-- 空态提示：无底色无边框，只用一行浅色小字，不挡绳子 -->
        <Border x:Name="EmptyHint"
                Background="Transparent"
                BorderThickness="0"
                Padding="12,2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,140,0,0"
                Panel.ZIndex="3"
                IsHitTestVisible="False">
            <TextBlock x:Name="EmptyHintText"
                       Text="绳子是空的 · 复制的内容合并进左信封，待办合并进右篮子；只有点「上绳」才挂"
                       Foreground="#8C8478"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>
