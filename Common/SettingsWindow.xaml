<Window x:Class="WinKit.Common.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit 设置" Width="760" Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ══════════════════════════════════════════
             左侧导航项
        ══════════════════════════════════════════ -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="6,2">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"/>
                            <Border x:Name="bar" Width="3" Height="16" CornerRadius="2"
                                    Background="#0078D4"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18000000"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#111"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             文字样式
        ══════════════════════════════════════════ -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#909090"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 卡片容器 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#B3FFFFFF"/>
            <Setter Property="BorderBrush" Value="#14000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,6,16,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- ══════════════════════════════════════════
             开关（CheckBox 改造）
        ══════════════════════════════════════════ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                                Background="#1F000000"
                                BorderBrush="#22000000" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.25" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#0078D4"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="track" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             下拉框
        ══════════════════════════════════════════ -->
        <Style x:Key="SettingsComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                Margin="2,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#280078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="Width" Value="168"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="#F2FFFFFF"
                                    BorderBrush="#26000000" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius6}"/>

                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                            <Path Data="M0,0 L4,4 L8,0"
                                  Stroke="#777" StrokeThickness="1.3"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,2,11,0" IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="2"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FCFCFC"
                                        BorderBrush="#22000000" BorderThickness="1"
                                        CornerRadius="8" Padding="2,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Opacity="0.14" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer Style="{StaticResource NarrowScrollViewer}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             数字输入框
        ══════════════════════════════════════════ -->
        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="CaretBrush" Value="#555"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="#F2FFFFFF"
                                BorderBrush="#26000000" BorderThickness="1"
                                CornerRadius="{StaticResource Radius6}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通文本输入（API Key / URL / 模型名 等） -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="CaretBrush" Value="#555"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="#F2FFFFFF"
                                BorderBrush="#26000000" BorderThickness="1"
                                CornerRadius="{StaticResource Radius6}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             滑块
        ══════════════════════════════════════════ -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="16">
                            <Ellipse Fill="White" Stroke="#33000000" StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Opacity="0.22" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="8" Height="8" Fill="#0078D4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSlider" TargetType="Slider">
            <Setter Property="Width" Value="170"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#1F000000"
                                    VerticalAlignment="Center" Margin="1,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#0078D4"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             次要按钮
        ══════════════════════════════════════════ -->
        <Style x:Key="MinorBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#F2FFFFFF"
                                BorderBrush="#26000000" BorderThickness="1"
                                CornerRadius="{StaticResource Radius6}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 只读的热键提示行 -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#FAF7F7F7"
            CornerRadius="10"
            BorderBrush="#1A000000"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════ 标题栏 ══════════ -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="设置"
                           VerticalAlignment="Center" Margin="18,0"
                           FontSize="12" Foreground="#666"/>
                <Button Content="✕"
                        Style="{StaticResource TitleBarBtn}"
                        Opacity="1"
                        HorizontalAlignment="Right" Margin="0,0,6,0"
                        Click="CloseBtn_Click"
                        ToolTip="关闭"/>
            </Grid>

            <!-- ══════════ 主体：导航 + 内容 ══════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="#0A000000" CornerRadius="0,0,0,10">
                    <ListBox x:Name="NavList"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,6,0,0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectedIndex="0"
                             FocusVisualStyle="{x:Null}"
                             SelectionChanged="NavList_SelectionChanged">
                        <ListBoxItem Content="通用"/>
                        <ListBoxItem Content="待办"/>
                        <ListBoxItem Content="剪贴板"/>
                        <ListBoxItem Content="翻译与 OCR"/>
                        <ListBoxItem Content="关于"/>
                    </ListBox>
                </Border>

                <!-- 右侧内容 -->
                <Grid Grid.Column="1">

                    <!-- ────────── ① 通用 ────────── -->
                    <ScrollViewer x:Name="PageGeneral"
                                  Style="{StaticResource NarrowScrollViewer}"
                                  Padding="24,18,18,18">
                        <StackPanel>
                            <TextBlock Text="通用" Style="{StaticResource PageTitle}"/>

                            <TextBlock Text="外观" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="窗口不透明度" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="作用于 TodoList 与剪贴板面板的背板" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="OpacitySlider"
                                                    Style="{StaticResource SettingsSlider}"
                                                    Minimum="40" Maximum="100"
                                                    SmallChange="1" LargeChange="5"
                                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                                    ValueChanged="OpacitySlider_ValueChanged"/>
                                            <TextBlock x:Name="OpacityValueText"
                                                       Text="80%"
                                                       Width="42" TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" Foreground="#555"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="启动与数据" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="开机启动" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="登录 Windows 后自动运行 WinKit" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="AutoStartToggle_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="配置与数据目录" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="DataDirText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开文件夹"
                                                Style="{StaticResource MinorBtn}"
                                                Click="OpenDataDir_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ────────── ② 待办 ────────── -->
                    <ScrollViewer x:Name="PageTodo"
                                  Style="{StaticResource NarrowScrollViewer}"
                                  Padding="24,18,18,18"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="待办" Style="{StaticResource PageTitle}"/>

                            <TextBlock Text="窗口行为" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="窗口置顶" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="始终显示在其他窗口之上" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TodoPinToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Click="TodoPinToggle_Click"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="鼠标穿透" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="开启后待办面板不拦截鼠标点击，便于贴边常驻参考" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TodoPassthroughToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Click="TodoPassthroughToggle_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ────────── ② 剪贴板 ────────── -->
                    <ScrollViewer x:Name="PageClipboard"
                                  Style="{StaticResource NarrowScrollViewer}"
                                  Padding="24,18,18,18"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="剪贴板" Style="{StaticResource PageTitle}"/>

                            <Border Style="{StaticResource Card}">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启用剪贴板监控" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="关闭后不再记录历史，Win+V 面板同时停用" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ClipMonitorToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Click="ClipMonitorToggle_Click"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="历史记录" Style="{StaticResource GroupTitle}"/>
                            <Border x:Name="ClipDetailCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="历史条数上限" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="10 – 500，超出后自动淘汰最旧的记录" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <TextBox x:Name="ClipMaxItemsBox" Grid.Column="1"
                                                 Style="{StaticResource NumBox}"
                                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                                 LostFocus="ClipMaxItemsBox_Commit"
                                                 KeyDown="NumBox_KeyDown"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="文本去重" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="复制重复内容时把旧记录提到最前，而不是新增一条" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ClipDedupToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="ClipDedupToggle_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="清空历史" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="ClipCountText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <Button x:Name="ClipClearBtn" Grid.Column="1" Content="清空"
                                                Style="{StaticResource MinorBtn}"
                                                Click="ClipClear_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="快捷键" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid Margin="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="呼出剪贴板历史面板"
                                               Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Style="{StaticResource KeyCap}">
                                        <TextBlock Text="Win + V" FontSize="11" Foreground="#444"
                                                   FontFamily="Consolas, Segoe UI"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ────────── ③ 翻译与 OCR ────────── -->
                    <ScrollViewer x:Name="PageTranslate"
                                  Style="{StaticResource NarrowScrollViewer}"
                                  Padding="24,18,18,18"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="翻译与 OCR" Style="{StaticResource PageTitle}"/>

                            <Border Style="{StaticResource Card}">
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="启用翻译与 OCR 模块" Style="{StaticResource RowLabel}"/>
                                        <TextBlock Text="关闭后注销四个全局热键，识别完全在本机进行、不联网" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TranslateToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              Click="TranslateToggle_Click"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="翻译" Style="{StaticResource GroupTitle}"/>
                            <Border x:Name="TranslateCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="翻译引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="Google 免费免 Key；OpenAI 走你的大模型（需填密钥）" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ProviderCombo" Grid.Column="1"
                                                  Style="{StaticResource SettingsCombo}"
                                                  SelectionChanged="ProviderCombo_Changed">
                                            <ComboBoxItem Content="Google 翻译" Tag="google"/>
                                            <ComboBoxItem Content="OpenAI 大模型" Tag="openai"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="目标语言" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="译文输出的语言" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="TargetLangCombo" Grid.Column="1"
                                                  Style="{StaticResource SettingsCombo}"
                                                  SelectionChanged="TargetLangCombo_Changed">
                                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                                            <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="日本語" Tag="ja"/>
                                            <ComboBoxItem Content="한국어" Tag="ko"/>
                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                            <ComboBoxItem Content="Русский" Tag="ru"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="源语言" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="一般保持「自动检测」即可" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SourceLangCombo" Grid.Column="1"
                                                  Style="{StaticResource SettingsCombo}"
                                                  SelectionChanged="SourceLangCombo_Changed">
                                            <ComboBoxItem Content="自动检测" Tag="auto"/>
                                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                                            <ComboBoxItem Content="繁體中文" Tag="zh-TW"/>
                                            <ComboBoxItem Content="English" Tag="en"/>
                                            <ComboBoxItem Content="日本語" Tag="ja"/>
                                            <ComboBoxItem Content="한국어" Tag="ko"/>
                                            <ComboBoxItem Content="Français" Tag="fr"/>
                                            <ComboBoxItem Content="Deutsch" Tag="de"/>
                                            <ComboBoxItem Content="Русский" Tag="ru"/>
                                        </ComboBox>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="搜索引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="识别结果窗右下角「搜索」按钮使用的引擎" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="SearchEngineCombo" Grid.Column="1"
                                                  Style="{StaticResource SettingsCombo}"
                                                  SelectionChanged="SearchEngineCombo_Changed">
                                            <ComboBoxItem Content="必应 Bing" Tag="bing"/>
                                            <ComboBoxItem Content="谷歌 Google" Tag="google"/>
                                            <ComboBoxItem Content="百度 Baidu" Tag="baidu"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="OpenAI 大模型" Style="{StaticResource GroupTitle}"/>
                            <Border x:Name="OpenAICard" Style="{StaticResource Card}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="API Key" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="明文保存在本地配置，仅在 OpenAI 引擎下使用" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <TextBox x:Name="OpenAIApiKeyBox" Grid.Column="1"
                                                 Style="{StaticResource FieldBox}"
                                                 TextChanged="OpenAIApiKeyBox_TextChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Base URL" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="OpenAI 兼容接口地址，留空用默认" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <TextBox x:Name="OpenAIBaseUrlBox" Grid.Column="1"
                                                 Style="{StaticResource FieldBox}"
                                                 TextChanged="OpenAIBaseUrlBox_TextChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="模型" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="如 gpt-4o-mini / gpt-4o / 自建兼容模型" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <TextBox x:Name="OpenAIModelBox" Grid.Column="1"
                                                 Style="{StaticResource FieldBox}"
                                                 TextChanged="OpenAIModelBox_TextChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="跳过证书校验" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="自签/内网/反代端点（如国内转发）证书不受信任时开启；官方地址请勿开启" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="OpenAISkipCertToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="OpenAISkipCertToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="本地 OCR 引擎" Style="{StaticResource GroupTitle}"/>
                            <Border x:Name="OcrCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="识别模型" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="ModelHintText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <ComboBox x:Name="ModelCombo" Grid.Column="1"
                                                  Style="{StaticResource SettingsCombo}"
                                                  SelectionChanged="ModelCombo_Changed"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="文字方向分类" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="识别竖排或旋转文字时开启；截图场景通常不需要，关闭可省一次推理" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AngleClsToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="AngleClsToggle_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="MKL-DNN 加速" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="Intel CPU 上显著提速；个别机器不稳定时可关闭" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="MkldnnToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="MkldnnToggle_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="CPU 推理线程数" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="ThreadsHintText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <TextBox x:Name="ThreadsBox" Grid.Column="1"
                                                 Style="{StaticResource NumBox}"
                                                 PreviewTextInput="NumberOnly_PreviewTextInput"
                                                 LostFocus="ThreadsBox_Commit"
                                                 KeyDown="NumBox_KeyDown"/>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="闲置自动瘦身" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="SlimHintText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBox x:Name="SlimSecondsBox"
                                                     Style="{StaticResource NumBox}"
                                                     PreviewTextInput="NumberOnly_PreviewTextInput"
                                                     LostFocus="SlimSecondsBox_Commit"
                                                     KeyDown="NumBox_KeyDown"/>
                                            <TextBlock Text="秒" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" FontSize="12" Foreground="#666"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#0F000000"/>

                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="启动时后台预热" Style="{StaticResource RowLabel}"/>
                                            <TextBlock Text="提前加载模型，首次按热键即时响应 · 下次启动生效" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="PreloadToggle" Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  Click="PreloadToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="快捷键" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="HotkeyPanel" Margin="0,10"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ────────── ④ 关于 ────────── -->
                    <ScrollViewer x:Name="PageAbout"
                                  Style="{StaticResource NarrowScrollViewer}"
                                  Padding="24,18,18,18"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="关于" Style="{StaticResource PageTitle}"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel Margin="0,14">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="WinKit" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                                        <TextBlock x:Name="VersionText" Text="v1.0.0"
                                                   FontSize="12" Foreground="#888"
                                                   Margin="8,0,0,3" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="待办 · 剪贴板 · 本地 OCR 翻译 三合一桌面工具箱"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"
                                               FontSize="12" Foreground="#888"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="信息" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <TextBlock Text="作者" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="worldoi" FontSize="13" Foreground="#444"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="#0F000000"/>
                                    <Grid Margin="0,10">
                                        <TextBlock Text="项目地址" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="LinkText"
                                                   Text="github.com/worldoi/WinKit"
                                                   FontSize="13" Foreground="#0066CC"
                                                   Cursor="Hand" TextDecorations="Underline"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   MouseLeftButtonDown="LinkText_MouseLeftButtonDown"/>
                                    </Grid>
                                    <Border Height="1" Background="#0F000000"/>
                                    <Grid Margin="0,10">
                                        <TextBlock Text="开源协议" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock Text="AGPL-3.0"
                                                   ToolTip="GNU Affero General Public License v3.0"
                                                   FontSize="13" Foreground="#444"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="#0F000000"/>
                                    <Grid Margin="0,10">
                                        <TextBlock Text="原项目" Style="{StaticResource RowLabel}" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="OriginLinkText"
                                                   Text="li5bo5/WinKit"
                                                   FontSize="13" Foreground="#0066CC"
                                                   Cursor="Hand" TextDecorations="Underline"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   MouseLeftButtonDown="OriginLinkText_MouseLeftButtonDown"
                                                   ToolTip="本项目的上游来源 · 查看原项目 releases"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="运行状态" Style="{StaticResource GroupTitle}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="OCR 引擎" Style="{StaticResource RowLabel}"/>
                                            <TextBlock x:Name="OcrStatusText" Style="{StaticResource RowHint}"/>
                                        </StackPanel>
                                        <Button Content="刷新" Grid.Column="1"
                                                Style="{StaticResource MinorBtn}"
                                                Click="RefreshOcrStatus_Click"/>
                                    </Grid>
                                    <Border x:Name="FallbackRow" Height="1" Background="#0F000000" Visibility="Collapsed"/>
                                    <TextBlock x:Name="FallbackText"
                                               Margin="0,10"
                                               FontSize="12" Foreground="#C86A00"
                                               TextWrapping="Wrap"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="© 2026 worldoi. All Rights Reserved."
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,10"
                                       FontSize="10" Foreground="#A0A0A0"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
