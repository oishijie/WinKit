<Window x:Class="WinKit.Common.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinKit 通知"
        Width="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <!-- 按钮样式统一走 App.xaml 的 WinBtn / WinBtnPrimary（v2.4 起收归单一来源），
         本窗口不再保留私有副本。按钮由代码动态创建，见 ToastWindow.xaml.cs。 -->

    <Border x:Name="RootBorder"
            Margin="12"
            CornerRadius="{StaticResource Radius12}"
            Background="#F5F7F7F7"
            BorderBrush="#1A000000"
            BorderThickness="1"
            Effect="{StaticResource WinShadow}">

        <Grid Margin="14,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：类型图标 + 标题/副标题 + 关闭 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBox"
                        Grid.Column="0"
                        Width="30" Height="30"
                        CornerRadius="8"
                        VerticalAlignment="Top">
                    <Path x:Name="IconPath"
                          Width="15" Height="15"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="13"
                               Foreground="#222222"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText"
                               FontSize="12"
                               Foreground="#909090"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBlock x:Name="CloseGlyph"
                           Grid.Column="2"
                           Text="&#x2715;"
                           FontSize="11"
                           Foreground="#A0A0A0"
                           Padding="4,2"
                           Cursor="Hand"
                           VerticalAlignment="Top"
                           MouseLeftButtonUp="CloseGlyph_MouseLeftButtonUp"/>
            </Grid>

            <!-- 第二行：缩略图 + 按钮行 -->
            <StackPanel x:Name="ActionsRow"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="40,10,0,0"
                        Visibility="Collapsed">

                <Border x:Name="ThumbBox"
                        Width="46" Height="34"
                        CornerRadius="5"
                        Background="#0F000000"
                        Margin="0,0,10,0"
                        ClipToBounds="True"
                        Visibility="Collapsed">
                    <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                </Border>

                <StackPanel x:Name="ButtonPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
