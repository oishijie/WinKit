<Window x:Class="WinKit.Translate.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translate" Width="440" Height="320"
        MinWidth="320" MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated"
        ResizeMode="CanResize"
        PreviewKeyDown="ResultWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- 结果窗底部小按钮统一样式（复制 / 翻译 / 搜索） -->
        <Style x:Key="ResultActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44000000"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AAA"/>
                                <Setter Property="BorderBrush" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#CCFFFFFF"
            CornerRadius="10"
            BorderBrush="#22000000"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ═══ 标题栏 ═══ -->
            <Grid Grid.Row="0" x:Name="TitleBar"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Background="Transparent">
                <TextBlock x:Name="TitleText"
                           Text="翻译结果"
                           VerticalAlignment="Center"
                           Margin="14,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#333"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="PinBtn"
                            Content="📌"
                            Style="{StaticResource TitleBarBtn}"
                            Opacity="1"
                            Click="PinBtn_Click"
                            ToolTip="钉住窗口"/>
                    <Button Content="✕"
                            Style="{StaticResource TitleBarBtn}"
                            Margin="0,0,4,0"
                            Opacity="1"
                            Click="CloseBtn_Click"
                            ToolTip="隐藏"/>
                </StackPanel>
            </Grid>

            <!-- ═══ 内容区 ═══ -->
            <ScrollViewer Grid.Row="1"
                          Style="{StaticResource NarrowScrollViewer}"
                          Padding="14,4,14,8"
                          Focusable="False">
                <StackPanel>
                    <!-- 原文区（可编辑，可先改掉 OCR 错字再翻译/搜索） -->
                    <StackPanel x:Name="SourceSection" Margin="0,0,0,8">
                        <TextBlock Text="原文"
                                   FontSize="11"
                                   Foreground="#888"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="SourceBox"
                                 FontSize="12.5"
                                 Foreground="#555"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 IsReadOnly="False"
                                 CaretBrush="#333"
                                 TextChanged="SourceBox_TextChanged"/>
                    </StackPanel>

                    <!-- 分隔线 -->
                    <Border Height="1" Background="#22000000" Margin="0,2,0,8"
                            x:Name="Separator" Visibility="Collapsed"/>

                    <!-- 译文/识别结果区（可编辑） -->
                    <TextBlock x:Name="TargetLabel"
                               Text="译文"
                               FontSize="11"
                               Foreground="#888"
                               Margin="0,0,0,3"/>
                    <TextBox x:Name="TargetBox"
                             Text="识别中..."
                             FontSize="14"
                             Foreground="#222"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             IsReadOnly="False"
                             CaretBrush="#333"
                             TextChanged="TargetBox_TextChanged"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ 底部状态栏 ═══ -->
            <Grid Grid.Row="2" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：复制 -->
                <Button x:Name="CopyBtn"
                        Grid.Column="0"
                        Content="复制"
                        Width="56"
                        Style="{StaticResource ResultActionBtn}"
                        Cursor="Hand"
                        Click="CopyBtn_Click">
                </Button>

                <!-- 中间：状态 -->
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           FontSize="11"
                           Foreground="#888"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 右侧：翻译 / 搜索（有识别结果时出现） -->
                <StackPanel x:Name="ActionPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Button x:Name="TranslateBtn"
                            Content="翻译"
                            Margin="0,0,6,0"
                            Style="{StaticResource ResultActionBtn}"
                            Click="TranslateBtn_Click"
                            ToolTip="翻译识别出的文字"/>
                    <Button x:Name="SearchBtn"
                            Content="搜索"
                            Style="{StaticResource ResultActionBtn}"
                            Click="SearchBtn_Click"
                            ToolTip="用默认浏览器搜索识别出的文字"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
